      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Pengguna">
      <EntityTypeMapping TypeName="MagangGoBIGModel.Pengguna">
        <MappingFragment StoreEntitySet="Pengguna">
          <ScalarProperty Name="PenggunaId" ColumnName="PenggunaId" />
